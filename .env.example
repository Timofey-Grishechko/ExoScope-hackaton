# ExoScope — параметры доступа к PostgreSQL в Docker.
# Скопируйте файл в .env и замените пароли перед публикацией/передачей проекта.
#
# .env читается docker compose автоматически.

# --- Владелец БД (суперпользователь контейнера) ---
POSTGRES_DB=exoscope
POSTGRES_USER=exoscope
POSTGRES_PASSWORD=exoscope_dev_pg

# Порт на локальной машине (только 127.0.0.1).
# 5433, чтобы не конфликтовать с локально установленным PostgreSQL на 5432.
POSTGRES_PORT=5433

# --- Роль приложения: SELECT/INSERT/UPDATE/DELETE ---
APP_DB_USER=exoscope_app
APP_DB_PASSWORD=exoscope_app_dev

# --- Роль только для чтения: SELECT ---
READONLY_DB_USER=exoscope_ro
READONLY_DB_PASSWORD=exoscope_ro_dev

# --- Строка подключения Go-бэкенда (api и worker читают DATABASE_URL) ---
# Роль приложения, порт на хосте = POSTGRES_PORT. Внутри docker-сети хост — postgres:5432.
DATABASE_URL=postgresql://exoscope_app:exoscope_app_dev@127.0.0.1:5433/exoscope?sslmode=disable
